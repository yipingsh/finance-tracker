# Copy to .env.local. All of these are public values that end up in the browser bundle;
# never put a secret (service-role key, Anthropic key, Turnstile secret) in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<from `npx supabase status`>
# Cloudflare Turnstile test site key (invisible, always passes). Use the real key in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
